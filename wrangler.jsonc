{
  // Openfloor Terminal — Cloudflare Worker settings.
  // The ONLY line you must change: paste your D1 database ID below (setup step 3).
  "name": "openfloor",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "openfloor", "database_id": "PASTE-YOUR-D1-DATABASE-ID-HERE" }
  ],
  "ai": { "binding": "AI" },
  // Keep the settings you type into the Cloudflare dashboard when GitHub redeploys.
  "keep_vars": true,
  "observability": { "enabled": true }
}
