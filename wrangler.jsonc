{
  // Openfloor Terminal — Cloudflare Worker settings.
  // Your D1 database is already filled in below.
  "name": "openfloor",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "openfloor", "database_id": "16061527-3fe5-425b-a940-f30980e8393a" }
  ],
  "ai": { "binding": "AI" },
  // Keep the settings you type into the Cloudflare dashboard when GitHub redeploys.
  "keep_vars": true,
  "observability": { "enabled": true }
}
